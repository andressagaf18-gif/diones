{
  "rewrites": [
    {
      "source": "/origem=:origem",
      "destination": "/index.html"
    },
    {
      "source": "/sistema",
      "destination": "/index.html"
    },
    {
      "source": "/sistema/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/diagnostico",
      "destination": "/index.html"
    },
    {
      "source": "/diagnostico/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/diagnosticofinderofsolutions",
      "destination": "/index.html"
    },
    {
      "source": "/diagnosticofinderofsolutions/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/admin",
      "destination": "/index.html"
    },
    {
      "source": "/admin/:path*",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/gerar-perguntas.js": {
      "maxDuration": 60
    },
    "api/diagnostico.js": {
      "maxDuration": 60
    },
    "api/tributario.js": {
      "maxDuration": 300
    }
  }
}
