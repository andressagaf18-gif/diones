{
  "rewrites": [
    {
      "source": "/origem=:origem",
      "destination": "/index.html"
    },
    {
      "source": "/sistema",
      "destination": "/index.html"
    },
    {
      "source": "/sistema/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/diagnostico",
      "destination": "/index.html"
    },
    {
      "source": "/diagnostico/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/diagnosticofinderofsolutions",
      "destination": "/index.html"
    },
    {
      "source": "/diagnosticofinderofsolutions/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/admin",
      "destination": "/index.html"
    },
    {
      "source": "/admin/:path*",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/crm?action=higiene-cron&tarefa=limpeza",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/crm?action=higiene-cron&tarefa=abandono",
      "schedule": "17 * * * *"
    }
  ],
  "functions": {
    "api/gerar-perguntas.js": {
      "maxDuration": 60
    },
    "api/diagnostico.js": {
      "maxDuration": 60
    },
    "api/tributario.js": {
      "maxDuration": 300
    },
    "api/pesquisa-tributaria.js": {
      "maxDuration": 300
    },
    "api/diagnosticos.js": {
      "maxDuration": 300
    }
  }
}
